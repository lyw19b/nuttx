        "echo \":00000001FF\" >> /data/d.hex",
        "hex2bin /data/d.hex /data/base.dtb",
        "echo \":40000000D00DFEED000000A20000003800000090000000280000001100000010000000000000001200000058000000000000000000000000000000000000000100000000DA\" > /data/d.hex",
