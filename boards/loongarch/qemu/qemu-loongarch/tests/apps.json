    },
    {
      "name": "tmpfs",
      "command": "fstest",
      "setup": [
        "mkdir /data",
        "mount -t tmpfs /data"
      ],
      "timeout": 120,
      "expect": [
        "File system tests done.*FAILED: 0"
      ]
    },
    {
      "name": "helloxx",
