# Additional application coverage for apps-testsuites/smp-apps-testsuites.
# Keep application sources and assertions unchanged.
CONFIG_CANCELLATION_POINTS=y
CONFIG_TLS_NCLEANUP=4
CONFIG_TLS_NELEM=8
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_PRIORITY_INHERITANCE=y
CONFIG_RR_INTERVAL=10
CONFIG_FS_AIO=y
CONFIG_TESTING_OSTEST_AIO=y
CONFIG_TESTING_OSTEST_AIOPATH="/data"
CONFIG_FS_SHMFS=y
CONFIG_EXAMPLES_SHM=y
CONFIG_EXAMPLES_POSIX_STDIO=y
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_EXAMPLES_CCTYPE=y
CONFIG_EXAMPLES_HELLOXX=y
CONFIG_NET_TCP_WRITE_BUFFERS=y
CONFIG_EXAMPLES_NETLOOP=y
CONFIG_EXAMPLES_POLL=y
CONFIG_FS_ROMFS=y
CONFIG_BOARDCTL_ROMDISK=y
CONFIG_EXAMPLES_ROMFS=y
