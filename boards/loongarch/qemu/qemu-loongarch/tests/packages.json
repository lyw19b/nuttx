{
  "cases": [
    {
      "name": "iozone",
      "command": "iozone -i 0 -i 1 -r 4k -s 256k -f /data/iozone.tmp",
      "setup": [
        "mkdir /data",
        "mount -t tmpfs /data"
      ],
      "expect": [
        "Iozone: Performance Test",
        "iozone test complete."
      ],
      "reject": [
        "Error",
        "ERROR"
      ],
      "timeout": 90
    },
    {
      "name": "mqjs",
      "command": "mqjs -e \"print(6 * 7)\"",
      "expect": [
        "(?m)^42$"
      ],
      "reject": [
        "Error"
      ],
      "timeout": 30
    },
    {
      "name": "toywasm",
      "command": "toywasm --load /data/answer.wasm --invoke answer",
      "setup": [
        "mkdir /data",
        "mount -t tmpfs /data",
        "echo \":100000000061736D010000000105016000017F03C4\" > /data/module.hex",
        "echo \":10001000020100070A0106616E7377657200000A2B\" >> /data/module.hex",
        "echo \":0A00200009010700410641076C0BBF\" >> /data/module.hex",
        "echo \":00000001FF\" >> /data/module.hex",
        "hex2bin /data/module.hex /data/answer.wasm"
      ],
      "expect": [
        "Result: 42:i32"
      ],
      "reject": [
        "Error:"
      ],
      "timeout": 30
    },
    {
      "name": "wasm3",
      "command": "wasm3 --func answer /data/answer.wasm",
      "setup": [
        "mkdir /data",
        "mount -t tmpfs /data",
        "echo \":100000000061736D010000000105016000017F03C4\" > /data/module.hex",
        "echo \":10001000020100070A0106616E7377657200000A2B\" >> /data/module.hex",
        "echo \":0A00200009010700410641076C0BBF\" >> /data/module.hex",
        "echo \":00000001FF\" >> /data/module.hex",
        "hex2bin /data/module.hex /data/answer.wasm"
      ],
      "reject": [
        "Error:"
      ],
      "timeout": 30
    },
