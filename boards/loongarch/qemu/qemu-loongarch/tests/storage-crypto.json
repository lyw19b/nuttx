    },
    {
      "name": "smart-stress-100",
      "command": "smart",
      "expect": [
        "Final memory usage:",
        "=== FILLING 100"
      ],
      "reject": [
        "ERROR:"
      ],
      "timeout": 60
    },
    {
      "name": "memstress-5s-smoke",
      "setup": [
        "memstress -d -m 8192 -n 128 -x4 -t 10000 &"
      ],
      "command": "sleep 5",
      "expect": [
        "MemoryStress:malloc",
        "MemoryStress:free",
        "MemoryStress:realloc",
        "MemoryStress:aligned_alloc"
      ],
      "reject": [
        "ERROR",
        "Failed"
      ]
    },
    {
      "name": "resmonitor-3s-smoke",
      "setup": [
        "showinfo -i 1 -d /tmp &"
      ],
      "command": "sleep 3",
      "expect": [
        "total",
        "/tmp"
      ],
      "reject": [
        "(?i)fail",
        "ERROR"
      ]
    },
    {
      "name": "cpuhog-3s-smoke",
      "setup": [
        "cpuhog > /tmp/consumer.log 2>&1 &",
        "cpuhog > /tmp/producer.log 2>&1 &",
        "sleep 3"
      ],
      "command": "cat /tmp/consumer.log /tmp/producer.log",
      "expect": [
        "consumer",
        "producer",
        "-+",
        "[+]"
      ],
      "reject": [
        "fifo:",
        "ERROR"
      ]
    },
    {
      "name": "cpuload-3s-smoke",
      "setup": [
        "cpuload -p 20 &",
        "sleep 3"
      ],
      "command": "ps",
      "expect": [
        "cpuload -p 20"
      ],
      "reject": [
        "ERROR"
      ]
    }
  ]
