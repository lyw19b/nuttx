CMN_ASRCS += loongarch_vectors.S loongarch_saveusercontext.S

CMN_CSRCS += loongarch_vector.c loongarch_initialize.c loongarch_syscall.c
CMN_CSRCS += loongarch_allocateheap.c loongarch_createstack.c
CMN_CSRCS += loongarch_cpuidlestack.c loongarch_irq.c loongarch_exit.c loongarch_exception.c
CMN_CSRCS += loongarch_getnewintctx.c loongarch_getintstack.c loongarch_initialstate.c
CMN_CSRCS += loongarch_modifyreg32.c loongarch_nputs.c loongarch_releasestack.c
CMN_CSRCS += loongarch_registerdump.c loongarch_stackframe.c loongarch_schedulesigaction.c
CMN_CSRCS += loongarch_sigdeliver.c loongarch_switchcontext.c
CMN_CSRCS += loongarch_usestack.c loongarch_tcbinfo.c

ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
  CMN_CSRCS += loongarch_idle.c
endif

ifneq ($(CONFIG_ALARM_ARCH),y)
  ifneq ($(CONFIG_TIMER_ARCH),y)
    CMN_CSRCS += loongarch_mdelay.c loongarch_udelay.c
  endif
endif


ifeq ($(CONFIG_STACK_COLORATION),y)
CMN_CSRCS += loongarch_checkstack.c
endif

ifeq ($(CONFIG_SCHED_THREAD_LOCAL),y)
CMN_CSRCS += loongarch_tls.c
endif

ifeq ($(CONFIG_ARCH_USE_MMU),y)
CMN_CSRCS += loongarch_mmu.c loongarch_tlb.c
CMN_ASRCS += loongarch_tlbrefill.S
endif

ifeq ($(CONFIG_SMP),y)
CMN_CSRCS += loongarch_smp.c
CMN_ASRCS += loongarch_secondary.S
endif

CMN_CSRCS += loongarch_timer.c loongarch_fpucmp.c

ifeq ($(CONFIG_LOONGARCH_MMU_TEST),y)
CMN_CSRCS += loongarch_mmutest.c
endif

ifeq ($(CONFIG_ARCH_HAVE_VFORK),y)
CMN_CSRCS += loongarch_fork.c
CMN_ASRCS += loongarch_forkentry.S
endif

ifeq ($(CONFIG_ARCH_ADDRENV),y)
CMN_CSRCS += loongarch_addrenv.c loongarch_asid.c
endif

ifeq ($(CONFIG_LOONGARCH_ASID_TEST),y)
CMN_CSRCS += loongarch_asidtest.c
endif

ifeq ($(CONFIG_BUILD_KERNEL),y)
CMN_CSRCS += loongarch_user.c loongarch_pagefault.c
STARTUP_OBJS = crt0$(OBJEXT)
endif

ifeq ($(CONFIG_LOONGARCH_USER_ACCESS),y)
CMN_CSRCS += loongarch_uaccess.c
endif

ifeq ($(CONFIG_LOONGARCH_VM_TEST),y)
CMN_CSRCS += loongarch_vmtest.c
endif

ifeq ($(CONFIG_LOONGARCH_LIBC_TEST),y)
CMN_CSRCS += loongarch_libctest.c
endif
