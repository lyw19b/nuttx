if ARCH_LOONGARCH

choice
	prompt "LoongArch chip"
	default ARCH_CHIP_LS2K0300

config ARCH_CHIP_LS2K0300
	bool "Loongson LS2K0300"

config ARCH_CHIP_QEMU_LOONGARCH
	bool "QEMU virt (LA64)"
	select ARCH_HAVE_MULTICPU
	select SERIAL_UART_ARCH_MMIO

endchoice

config ARCH_CHIP
	string
	default "ls2k0300" if ARCH_CHIP_LS2K0300
	default "qemu" if ARCH_CHIP_QEMU_LOONGARCH

config ARCH_LOONGARCH64
	bool
	default y
	select ARCH_HAVE_FORK if BUILD_FLAT
	select ARCH_HAVE_STACKCHECK
	select ARCH_HAVE_SETJMP
	select ARCH_SETJMP_H
	select ARCH_HAVE_ADDRENV
	select ARCH_NEED_ADDRENV_MAPPING
	select ARCH_KERNEL_STACK if BUILD_KERNEL
	select LIBC_ARCH_ELF_64BIT if LIBC_ARCH_ELF
	select ARCH_HAVE_MMU
	select ARCH_HAVE_FPU
	select ARCH_HAVE_DPFPU
	select ARCH_HAVE_TESTSET

config ARCH_USE_MMU
	default y
	select MM_PGALLOC

config LOONGARCH_MMU_PTW
	bool "Use hardware page walking when available"
	default y
	depends on ARCH_USE_MMU
	---help---
		Enable PWCH.HPTW only when CPUCFG2 advertises hardware page
		walking. Other CPUs use the software refill handler. Disable
		this option to test software refill on a PTW-capable CPU.

config LOONGARCH_PAGE_POOL_SIZE
	hex "Physical page pool size"
	default 0x200000
	depends on MM_PGALLOC
	---help---
		Reserve this many bytes at the end of RAM for the NuttX page
		allocator. The size must be a multiple of 4096 and must leave
		enough memory for the kernel, idle stacks, and normal heap.

config LOONGARCH_ASID_BITS
	int "Maximum ASID width"
	default 10
	range 2 10
	depends on ARCH_ADDRENV
	---help---
		Limit the number of hardware address-space identifier bits used
		on each CPU. The CPU's ASIDBITS value can reduce this further.
		ASID zero is reserved for the boot mappings. Normally use all ten
		bits; smaller values allow regression tests to force ASID reuse.

config LOONGARCH_USER_ACCESS
	bool "Strict user syscall argument validation"
	default y
	depends on BUILD_KERNEL
	---help---
		Stage supported syscall arguments in kernel-owned buffers. Reject
		interfaces without an argument policy with ENOSYS. Device ioctls,
		asynchronous operations and complex user synchronization objects
		require separate adapters before they can be enabled safely.

config LOONGARCH_USER_COPY_MAX
	int "Maximum staged bytes per user syscall"
	default 65536
	range 4096 1048576
	depends on LOONGARCH_USER_ACCESS

config LOONGARCH_DEMAND_PAGING
	bool "Demand-zero process heaps and copy-on-write pages"
	default y
	depends on BUILD_KERNEL
	---help---
		Reserve process heap pages without allocating physical storage.
		Reads share an immutable zero page; writes allocate private pages.
		Resolve page faults in thread context and synchronize all CPUs
		before releasing replaced backing pages.

config LOONGARCH_VM_TEST
	bool "Test demand-zero pages, COW and checked user copies"
	default y if LOONGARCH_USER_TEST
	depends on LOONGARCH_DEMAND_PAGING
	---help---
		Exercise actual page faults and independent COW roots before user
		startup in the QEMU regression configuration.

config LOONGARCH_INITIAL_HEAP_SIZE
	hex "Initially resident user heap size"
	default 0x10000
	depends on LOONGARCH_DEMAND_PAGING
	---help---
		Keep this page-aligned bootstrap heap resident for the ELF loader,
		which initializes allocator metadata and the initial user stack
		with interrupts masked. Later heap extensions are demand-zero.
		This must accommodate the initial stack and allocator overhead.

config LOONGARCH_ASID_TEST
	bool "Test ASID retention and rollover before user startup"
	depends on LOONGARCH_USER_TEST && LOONGARCH_ASID_BITS <= 3
	depends on DEBUG_ASSERTIONS
	---help---
		Create more address environments than available ASIDs and check
		translations at identical virtual addresses on every CPU. Run
		before any user process starts, while ASID zero is still active.

config LOONGARCH_MMU_TEST
	bool "Build the MMU and SMP bring-up test"
	depends on ARCH_USE_MMU && DEBUG_ASSERTIONS
	---help---
		Provide loongarch_mmutest_main as an optional init entry point.
		Test page mapping, even/odd TLB refill, cross-CPU remapping,
		page-table reclamation and allocation failure rollback.

config LOONGARCH_MMU_TEST_FAULT
	int "Expected page fault after the MMU test (0=none, 1=write, 2=read)"
	default 0
	range 0 2
	depends on LOONGARCH_MMU_TEST
	---help---
		After the normal tests, deliberately write to a read-only page
		or read an unmapped page. These negative tests must terminate
		in the exception handler. Do not enable for normal operation.

config LOONGARCH_USER_TEST
	bool "Run ELF process isolation and syscall tests"
	depends on BUILD_KERNEL && ARCH_CHIP_QEMU_LOONGARCH
	select BOARD_LATE_INITIALIZE
	select FS_TMPFS
	---help---
		Embed a standalone ELF regression program and launch concurrent
		processes through the NuttX loader. Test syscalls, signals, private
		data, and user faults without terminating the kernel.

source "arch/loongarch/src/ls2k0300/Kconfig"

endif # ARCH_LOONGARCH
